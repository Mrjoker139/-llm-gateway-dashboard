# LLM 网关仪表盘 — API key 配置
#
# 复制这个文件为 .env 并填入你的 key (或直接改这里).
# 没配 key 的厂商会自动跳过, 不影响其他功能.
#
# 网关地址: http://127.0.0.1:8787/v1
# 模型名格式: <厂商>/<模型名>, 例如 deepseek/deepseek-chat

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Kimi (月之暗面) ----
# 两种计费方式二选一, 按 base_url 自动判断用哪个额度接口:
#   Coding Plan 套餐: https://api.kimi.com/coding/v1   -> 查 5 小时 / 7 天窗口用量
#   开放平台按量付费: https://api.moonshot.cn/v1        -> 查账户余额
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ---- Google Gemini ----
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- 火山方舟 (Coding Plan / Agent Plan) ----
# 火山不提供套餐额度查询接口, 额度请到控制台看.
# 可选: 填了 AK/SK (控制台「访问控制」创建) 就能查账户现金余额.
ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_ACCESS_KEY=
# ARK_SECRET_KEY=

# ---- SiliconFlow (可选) ----
SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- Antigravity OAuth 客户端凭据 (可选) ----
# 用于「Antigravity 订阅配额」和 Gemini 节点检测 (复用 Google Pro 会员额度).
# 这是 Antigravity 应用自带的安装型应用凭据, 不是你的个人凭据.
# 获取方式: 从 Antigravity 安装目录里找, 或抓一次它刷新令牌的请求即可看到.
# 不填的话, 这两块功能会提示凭据未配置, 其他功能不受影响.
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# ---- 代理内核 (可选, 影响"节点测速"和 Gemini 相关功能) ----
# 需要 Clash 风格的本地控制 API. 默认值对应 SakuraCat.
# 换客户端时改这两个即可:
#   SakuraCat           -> 12440 / 12450  (默认)
#   Clash Verge / mihomo -> 9090  / 7890
#   ClashX / CFW        -> 9090  / 7890
# V2Ray / Xray / WireGuard 没有控制 API, 这两块功能用不了.
# CLASH_API=http://127.0.0.1:12440
# CLASH_PROXY=http://127.0.0.1:12450
